# 编译缓存
__pycache__/
*.pyc
*.pyo

# 工具二进制（本地可选，CI 环境靠 apt 装）
tools/7zz
tools/7z.tar.xz

# IDE / Trae 自动产物
.trae-html-share-packages/
.trae*
# 但手工维护的技能要进仓库（排除 .trae/skills 下的 SKILL.md）
!.trae/
!.trae/skills/
!.trae/skills/**
# 技能目录里的字节码缓存仍不入库（上面的 ! 会连它一起放行，这里再关掉）
.trae/skills/**/__pycache__/
# ssh-site-maintain 只留技能包（skillpack 私库，冷启动时恢复），仓库不跟踪
.trae/skills/ssh-site-maintain/
.vscode/
.idea/

# 本地临时脚本（CI 不运行）
.tmp_main.js

# 分析用临时产物（不属于项目，勿提交）
_tmp_analysis/

# 沙箱 SSH 凭据（冷启动由 skillpack 仓恢复，绝不入库）
.ssh/

# 系统
.DS_Store
Thumbs.db

# 截图/分析产物
.uploads/
